# =============================================================================
# Simple Finance Multi-household — example environment configuration.
# Placeholders only. This repository is public: never add real identities,
# addresses, amounts or installation secrets here.
#
# Production: place at /data/.env in the new appdata root
#   /mnt/user/appdata/simple-finance-multi-household/.env
# This is a trusted, admin-owned (0600) file sourced by the container entrypoint.
# It must never be copied into the image or included in a household backup.
#
# IMPORTANT: the current source is still the inherited single-household app.
# These current DATABASE_PATH / DOCUMENTS_DIR / AUTH_ALLOWED_EMAILS settings
# are transitional. They are not the target multi-household registry or tenant
# routing. See docs/MULTI_HOUSEHOLD_PLAN.md before changing them.
# =============================================================================

# --- Storage ------------------------------------------------------------------
# Development data root (defaults to ./data); production container root is /data.
# DATA_DIR=./data
#
# Legacy single-household overrides only. The target app will keep a system
# registry under /data/system/ and each tenant's database + documents under
# /data/households/<opaque-household-id>/. Never point these at the original
# /mnt/user/appdata/simple-finance installation.
# DATABASE_PATH=
# DOCUMENTS_DIR=

# --- Authentication (Cloudflare Access) --------------------------------------
# Issuer: https://<your-team>.cloudflareaccess.com
# Audience: the Access application's AUD tag
# The app independently verifies the Cf-Access-Jwt-Assertion JWT with jose.
# Cloudflare's email policy is the outer gate; target in-app household
# assignment will come from the pre-provisioned system registry. A verified
# email that is not assigned to a household must be denied (no self-sign-up).
# AUTH_ISSUER=
# AUTH_AUDIENCE=
# Optional override (defaults to $AUTH_ISSUER/cdn-cgi/access/certs):
# AUTH_CERTS_URL=
#
# TRANSITION ONLY: the inherited single-household app currently also requires
# this static allowlist. It will be replaced/changed when registry-based tenant
# authorization is implemented; it is not the planned household onboarding UI.
# AUTH_ALLOWED_EMAILS=alex@example.com,sam@example.com

# --- Development identity (NEVER honoured in production) ---------------------
# Development bypass works only when AUTH_DEV_BYPASS=true, NODE_ENV is not
# production, and an identity is configured. It is for local development and
# Playwright only; it does not test Cloudflare or household assignment.
# AUTH_DEV_BYPASS=false
# AUTH_DEV_IDENTITY_EMAIL=dev@example.com

# --- Server -------------------------------------------------------------------
# PORT=3000

# --- Container only -----------------------------------------------------------
# Unraid defaults: 99 (nobody) and 100 (users). The new app maps host port 3009
# to container port 3000 and uses bridge networking.
# PUID=99
# PGID=100
