{
  "name": "simple-finance",
  "version": "1.41.0",
  "private": true,
  "description": "Private finance app for households managing money carefully. See docs/SPEC.md.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "themes:build": "node --import tsx scripts/themes/cli.mts",
    "themes:check": "node --import tsx scripts/themes/cli.mts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.cjs",
    "db:migrate:registry": "node scripts/registry-migrate.cjs",
    "rehearse:import": "node --import tsx scripts/rehearse-import.mts",
    "acceptance": "node --import tsx scripts/acceptance.mts",
    "test:e2e": "playwright test",
    "test:e2e:fresh": "E2E_FRESH=1 playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "next": "^16.4.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tar": "^7.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
